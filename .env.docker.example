# Docker: Corporate con su base en línea y Network con PostgreSQL local.
# Generar solo este archivo: python scripts/docker/crear_entorno_local.py
IMAGEN_BACKEND=vitago-backend:0.57.0
POLITICA_DESCARGA_IMAGEN=never
ARCHIVO_ENV_CORPORATIVO=.env.render.corporativo
PUBLICAR_EN=127.0.0.1
PUERTO_CORPORATIVO=8001
PUERTO_NETWORK=8000
SERVIDORES_DOCKER=localhost,127.0.0.1
ORIGENES_WEB_DOCKER=
REDIRECCION_SSL_DOCKER=false
CONFIAR_PROXY_HTTPS_DOCKER=false
DESVIACIONES_AUTOMATICAS_HABILITADAS=true
DESVIACION_RADIO_METROS=150
DESVIACION_RADIO_REGRESO_METROS=75
DESVIACION_PERMANENCIA_SEGUNDOS=60
DESVIACION_MINIMO_PUNTOS=3
DESVIACION_PRECISION_MAXIMA_METROS=50
DESVIACION_ANTIGUEDAD_MAXIMA_SEGUNDOS=60
CLAVE_DB_NETWORK=GENERAR
CLAVE_SECRETA_NETWORK=GENERAR
CLAVE_JWT_NETWORK=GENERAR
CLAVE_REFRESCO_NETWORK=GENERAR
